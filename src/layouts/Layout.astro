---
import { SEO } from "astro-seo";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title="Fathan Maulana Portfolio"
      description="A portfolio of Fathan Maulana, a frontend developer skilled in React, Laravel, and TailwindCSS."
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
        meta: [
          {
            property: "og:image",
            content: "https://avatars.githubusercontent.com/u/94539481?v=4",
          },
          {
            property: "og:title",
            content: "Fathan Maulana Portfolio",
          },
          {
            property: "og:description",
            content:
              "Frontend Developer portfolio, featuring projects using React, Laravel, and more.",
          },
          {
            property: "og:type",
            content: "website",
          },
        ],
      }}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Fathan Maulana - Portfolio</title>
  </head>
  <body class="font-display">
    <slot />
  </body>
</html>
